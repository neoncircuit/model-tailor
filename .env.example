# ==============================================================================
# API Keys for model-tailor Pipeline
# ==============================================================================
# Copy this file to .env and fill in your credentials.
#
# These keys are used by model-tailor's teacher model client (src/llm/client.py)
# to generate synthetic training data and run LLM-as-judge evaluation.

# OpenAI API key (provider: openai)
# Models: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic API key (provider: anthropic)
# Models: claude-sonnet-4-6, claude-haiku-4-5
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI API key (provider: gemini)
# Models: gemini-2.0-flash, gemini-2.5-pro
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Weights & Biases API key (for training monitoring)
# Get your key at: https://wandb.ai/settings
WANDB_API_KEY=

# HuggingFace token (for pushing models to the Hub)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ==============================================================================
# Optional Services
# ==============================================================================

# Ollama local LLM server (provider: ollama)
# No API key needed. Ollama runs locally and exposes an OpenAI-compatible API.
# Install from: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

# MLFlow tracking server (for experiment tracking and model registry)
# MLFlow runs locally with SQLite backend. No setup required.
MLFLOW_TRACKING_URI=http://localhost:5000

# ==============================================================================
# Note on .claude/settings.json (separate from this project)
# ==============================================================================
# If you have a .claude/settings.json file in this project, it may contain
# GLM or other model configuration for Claude Code (the AI assistant you're
# talking to right now). That configuration is SEPARATE from model-tailor's
# teacher model settings and does NOT affect this pipeline.
#
# model-tailor uses the API keys above (from this .env file) via its
# TeacherClient class, which explicitly routes to the real provider APIs
# (api.anthropic.com, api.openai.com, etc.) regardless of any Claude Code
# settings you may have configured.
